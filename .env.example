# OpenRouter (default). Any OpenAI-compatible provider works:
#   OpenAI      -> https://api.openai.com/v1
#   Ollama      -> http://localhost:11434/v1  (key can be "ollama")
#   Groq        -> https://api.groq.com/openai/v1
OPENROUTER_API_KEY=

# Model id served by the endpoint above.
MODEL=openrouter/free

# Optional overrides
# EASYRAG_BASE_URL=https://openrouter.ai/api/v1
# EASYRAG_DB=~/.local/share/easy-rag/chroma
# EASYRAG_TOP_K=5
# EASYRAG_CHUNK_SIZE=1200
# EASYRAG_CHUNK_OVERLAP=200
